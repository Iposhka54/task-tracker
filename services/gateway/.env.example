HTTP_PORT=80
LOG_LEVEL=INFO
ENVIRONMENT=development

AUTH_GRPC_ADDRESS=localhost:9001
AUTH_GRPC_INSECURE=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_AUTH_BURST=10
RATE_LIMIT_API_RPM=100
RATE_LIMIT_API_BURST=100
RATE_LIMIT_CLEANUP_INTERVAL=5m
RATE_LIMIT_MAX_AGE=10m

TRACE_ENDPOINT=localhost:4317
TRACE_INSECURE=true
TRACE_SAMPLING_RATE=1.0
TRACE_BATCH_TIMEOUT=5s

METRICS_ENDPOINT=localhost:9090
METRICS_URL_PATH=/api/v1/otlp/v1/metrics
METRICS_INSECURE=true
